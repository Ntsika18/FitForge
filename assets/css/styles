/* =============================================
       CSS VARIABLES — single source of truth for
       all colours, radii, and shadow tokens.
       Swap between light/dark by toggling .dark
       on <body>.
    ============================================= */
    :root {
      --bg:        #f0ede8;
      --bg2:       #e8e4dc;
      --surface:   #faf8f5;
      --surface2:  #f0ede8;
      --border:    rgba(0,0,0,0.07);
      --text:      #1a1714;
      --text2:     #6b6560;
      --accent:    #c84b31;   /* burnt sienna — athletic, warm */
      --accent2:   #e8773d;   /* amber highlight */
      --green:     #2e7d52;
      --radius:    1.5rem;
      --shadow:    0 12px 40px -8px rgba(0,0,0,0.12);
      --nav-h:     72px;
    }
    body.dark {
      --bg:        #111210;
      --bg2:       #1a1917;
      --surface:   #1f1e1b;
      --surface2:  #27251f;
      --border:    rgba(255,255,255,0.06);
      --text:      #f0ede8;
      --text2:     #8a8580;
      --shadow:    0 12px 40px -8px rgba(0,0,0,0.6);
    }

    /* =============================================
       RESET & BASE
    ============================================= */
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

    body {
      font-family: 'Manrope', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      transition: background 0.3s, color 0.3s;
    }

    /* =============================================
       APP SHELL — centred mobile column
    ============================================= */
    .app {
      max-width: 480px;
      margin: 0 auto;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
      background: var(--bg);
    }

    /* =============================================
       TOP HEADER BAR
    ============================================= */
    .header {
      padding: 1.25rem 1.5rem 0.75rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    .logo {
      font-family: 'Syne', sans-serif;
      font-size: 1.7rem;
      font-weight: 800;
      letter-spacing: -1px;
      color: var(--accent);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    /* Dark-mode toggle pill */
    .theme-btn {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 3rem;
      padding: 0.5rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-family: 'Manrope', sans-serif;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text2);
      cursor: pointer;
      transition: all 0.2s;
    }
    .theme-btn:hover { color: var(--accent); border-color: var(--accent); }

    /* =============================================
       PAGE SYSTEM — only the active .page shows
    ============================================= */
    .page { display: none; flex-direction: column; flex: 1; padding-bottom: 90px; }
    .page.active { display: flex; animation: fadeIn 0.3s ease; }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* =============================================
       BOTTOM NAV BAR
    ============================================= */
    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 480px;
      background: var(--surface);
      border-top: 1px solid var(--border);
      display: flex;
      z-index: 200;
    }
 
    .nav-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.2rem;
      padding: 0.8rem 0.5rem;
      cursor: pointer;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text2);
      transition: color 0.2s;
      border: none;
      background: none;
      font-family: 'Manrope', sans-serif;
    }
    .nav-item i { font-size: 1.25rem; transition: transform 0.2s; }
    .nav-item.active { color: var(--accent); }
    .nav-item.active i { transform: translateY(-2px); }
    .nav-item:hover { color: var(--accent); }
    a.nav-item { text-decoration: none; }
 
    /* =============================================
       REUSABLE CARD
    ============================================= */
    .card {
      background: var(--surface);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      padding: 1.4rem;
      margin: 0.75rem 1.25rem;
      box-shadow: var(--shadow);
    }
 
    /* =============================================
       SECTION TITLE INSIDE CARD
    ============================================= */
    .section-title {
      font-family: 'Syne', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: -0.3px;
      margin-bottom: 1.1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .section-title i { color: var(--accent); }
 
    /* =============================================
       FORM INPUTS
    ============================================= */
    .row  { display: flex; gap: 0.75rem; }
    .field { flex: 1; display: flex; flex-direction: column; gap: 0.3rem; }

    .field:last-child {
    flex: 1 !important;
    max-width: 120px; /* force a smaller size */
    }
 
    label {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--text2);
    }
 
    input, select {
      background: var(--surface2);
      border: 1.5px solid var(--border);
      border-radius: 0.9rem;
      padding: 0.75rem 1rem;
      font-size: 0.92rem;
      font-family: 'Manrope', sans-serif;
      color: var(--text);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    input:focus, select:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(200,75,49,0.15);
    }
 
    /* =============================================
       BUTTONS
    ============================================= */
    .btn {
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 2rem;
      padding: 0.85rem 1.5rem;
      font-family: 'Manrope', sans-serif;
      font-weight: 700;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      cursor: pointer;
      transition: transform 0.15s, filter 0.15s;
      letter-spacing: -0.2px;
    }
    .btn:hover { filter: brightness(1.1); transform: translateY(-1px); }
    .btn:active { transform: translateY(0); }

    /* =============================================
       ——— PAGE 1: WORKOUT ———
    ============================================= */

    /* Hero banner with unsplash workout image */
    .hero-banner {
      margin: 0.75rem 1.25rem;
      border-radius: var(--radius);
      overflow: hidden;
      position: relative;
      height: 180px;
      box-shadow: var(--shadow);
    }
    .hero-banner img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
    }
    .hero-banner::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(to bottom, transparent 30%, rgba(0,0,0,0.7));
    }
    .hero-banner .hero-text {
      position: absolute;
      bottom: 1rem; left: 1.25rem;
      z-index: 1;
      color: #fff;
    }
    .hero-banner .hero-text h2 {
      font-family: 'Syne', sans-serif;
      font-size: 1.4rem;
      font-weight: 800;
      letter-spacing: -0.5px;
    }
    .hero-banner .hero-text p {
      font-size: 0.78rem;
      opacity: 0.85;
      margin-top: 0.15rem;
    }

    /* Input gap inside card */
    .input-group { display: flex; flex-direction: column; gap: 0.85rem; }

    /* Workout result box */
    .workout-result {
      margin-top: 1rem;
      background: var(--surface2);
      border-radius: 1.1rem;
      padding: 1rem;
      border: 1px solid var(--border);
    }
    .regimen-list { list-style: none; margin-top: 0.6rem; }

    /* Each exercise row — card-style with image */
    .exercise-item {
      display: flex;
      gap: 0.9rem;
      align-items: flex-start;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--border);
    }
    .exercise-item:last-child { border-bottom: none; }

    /* Small circular workout image thumbnail */
    .exercise-thumb {
      width: 58px;
      height: 58px;
      border-radius: 0.8rem;
      object-fit: cover;
      flex-shrink: 0;
      border: 2px solid var(--border);
    }

    .exercise-info { flex: 1; min-width: 0; }
    .exercise-name {
      font-weight: 700;
      font-size: 0.88rem;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .exercise-name i { color: var(--accent); font-size: 0.75rem; }
    .exercise-sets {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--accent2);
      margin-top: 0.1rem;
    }
    /* Expandable instructions */
    .exercise-instructions {
      font-size: 0.75rem;
      color: var(--text2);
      margin-top: 0.35rem;
      line-height: 1.55;
      display: none; /* hidden by default; toggled on click */
    }
    .exercise-instructions.open { display: block; }
    .toggle-inst {
      font-size: 0.68rem;
      color: var(--accent);
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      margin-top: 0.3rem;
      background: none;
      border: none;
      font-family: 'Manrope', sans-serif;
      padding: 0;
    }
    .toggle-inst:hover { text-decoration: underline; }

    /* Plan meta footer */
    .plan-meta {
      margin-top: 0.8rem;
      font-size: 0.72rem;
      color: var(--text2);
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .plan-meta span { display: flex; align-items: center; gap: 0.3rem; }

    /* =============================================
       ——— PAGE 2: SCANNER ———
    ============================================= */

    /* Big scanner visual */
    .scanner-hero {
      margin: 0.75rem 1.25rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2rem 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      box-shadow: var(--shadow);
    }

    .barcode-visual {
      display: flex;
      gap: 3px;
      height: 60px;
      align-items: flex-end;
    }
    /* Animated barcode bars — purely decorative CSS */
    .barcode-visual span {
      background: var(--text);
      border-radius: 2px;
      animation: barPulse 1.5s ease-in-out infinite;
    }
    @keyframes barPulse {
      0%, 100% { opacity: 0.2; }
      50%       { opacity: 1; }
    }

    .scanner-label {
      font-family: 'Syne', sans-serif;
      font-size: 1.3rem;
      font-weight: 800;
      text-align: center;
      letter-spacing: -0.5px;
    }
    .scanner-sub {
      font-size: 0.78rem;
      color: var(--text2);
      text-align: center;
    }

    /* Barcode input row */
    .scan-row {
      display: flex;
      gap: 0.6rem;
      width: 100%;
      margin-top: 0.5rem;
    }
    .scan-row input {
      flex: 1;
      border-radius: 2rem;
      padding: 0.8rem 1.2rem;
    }
    .scan-row .btn { padding: 0.8rem 1.25rem; border-radius: 2rem; white-space: nowrap; }

    /* Hint chips */
    .hint-chips { display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; margin-top: 0.25rem; }
    .chip {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 2rem;
      padding: 0.3rem 0.8rem;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--text2);
      cursor: pointer;
      transition: all 0.2s;
    }
    .chip:hover { background: var(--accent); color: #fff; border-color: var(--accent); }

    /* Product result card */
    .product-card {
      margin: 0 1.25rem;
      animation: fadeIn 0.3s ease;
    }
    .product-name {
      font-family: 'Syne', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
    }
    .nutrition-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.6rem;
      margin-top: 0.9rem;
    }
    .nutrition-cell {
      background: var(--surface2);
      border-radius: 0.9rem;
      padding: 0.75rem 0.4rem;
      text-align: center;
      border: 1px solid var(--border);
    }
    .nutrition-cell .val {
      font-family: 'Syne', sans-serif;
      font-size: 1.3rem;
      font-weight: 800;
      color: var(--accent);
      display: block;
    }
    .nutrition-cell small {
      font-size: 0.65rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      color: var(--text2);
    }

    /* Macro bar chart */
    .macro-bar-wrap { margin-top: 0.9rem; }
    .macro-label-row { display: flex; justify-content: space-between; font-size: 0.72rem; color: var(--text2); margin-bottom: 0.3rem; font-weight: 600; }
    .macro-bar { height: 8px; background: var(--surface2); border-radius: 2rem; overflow: hidden; margin-bottom: 0.45rem; }
    .macro-fill { height: 100%; border-radius: 2rem; transition: width 0.8s cubic-bezier(.4,0,.2,1); }
    .fill-protein { background: var(--accent); }
    .fill-carbs   { background: var(--accent2); }
    .fill-fat     { background: var(--green); }

    /* Error message */
    .error-msg {
      margin: 0 1.25rem;
      padding: 0.9rem 1.1rem;
      background: #fef2f2;
      border: 1px solid #fca5a5;
      border-radius: 1rem;
      color: #b91c1c;
      font-size: 0.85rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    body.dark .error-msg { background: #2d1515; border-color: #7f1d1d; color: #fca5a5; }

    /* Scanning spinner */
    .scanning-msg {
      margin: 0 1.25rem;
      color: var(--text2);
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 600;
    }

    /* =============================================
       ——— PAGE 3: TIPS ———
    ============================================= */
    .tips-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin: 0.75rem 1.25rem;
    }
    .tip-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      margin-bottom: 0.75rem;
      box-shadow: var(--shadow);
    }
    .tip-img {
      width: 100%; height: 160px;
      object-fit: cover;
      display: block;
    }
    .tip-body { padding: 1.1rem; }
    .tip-tag {
      display: inline-block;
      background: var(--accent);
      color: #fff;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      padding: 0.2rem 0.6rem;
      border-radius: 2rem;
      margin-bottom: 0.5rem;
    }
    .tip-title { font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 700; margin-bottom: 0.4rem; letter-spacing: -0.3px; }
    .tip-text { font-size: 0.82rem; color: var(--text2); line-height: 1.6; }

        /* =============================================
       ——— PAGE 4: SAVED WORKOUTS ———
       Cards styled after the original exercise-
       list format with expand/collapse.
    ============================================= */
 
    /* Empty state */
    .saved-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      padding: 3rem 1.5rem;
      text-align: center;
      color: var(--text2);
    }
    .saved-empty i { font-size: 2.5rem; color: var(--border); }
    .saved-empty p { font-size: 0.85rem; line-height: 1.6; }
 
    /* Individual saved workout card */
    .saved-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin: 0.75rem 1.25rem;
      box-shadow: var(--shadow);
      overflow: hidden;
      animation: fadeIn 0.3s ease;
    }
 
    .saved-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.25rem;
      cursor: pointer;
      gap: 0.75rem;
    }
    .saved-card-title {
      font-family: 'Syne', sans-serif;
      font-size: 0.95rem;
      font-weight: 700;
      flex: 1;
      min-width: 0;
    }
    .saved-card-date {
      font-size: 0.7rem;
      color: var(--text2);
      white-space: nowrap;
    }
 
    .saved-card-body {
      display: none;
      padding: 0 1.25rem 1rem;
      border-top: 1px solid var(--border);
    }
    .saved-card-body.open { display: block; }
 
    /* Rendered plan text inside saved card — same style as AI bubble */
    .saved-plan-text {
      font-size: 0.84rem;
      line-height: 1.65;
      color: var(--text);
      padding-top: 0.75rem;
    }
    .saved-plan-text strong { color: var(--accent); }
    .saved-plan-text ul { padding-left: 1.1rem; margin: 0.3rem 0; }
    .saved-plan-text li { margin-bottom: 0.2rem; }
    .saved-plan-text h3 { font-family:'Syne',sans-serif; font-size:0.9rem; margin:0.5rem 0 0.2rem; }
 
    /* Delete button inside saved card */
    .delete-saved-btn {
      background: none;
      border: 1px solid #fca5a5;
      color: #b91c1c;
      border-radius: 2rem;
      padding: 0.35rem 0.9rem;
      font-size: 0.72rem;
      font-weight: 700;
      cursor: pointer;
      font-family: 'Manrope', sans-serif;
      margin-top: 0.75rem;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      transition: all 0.2s;
    }
    .delete-saved-btn:hover { background: #fef2f2; }
    body.dark .delete-saved-btn { border-color: #7f1d1d; color: #fca5a5; }
    body.dark .delete-saved-btn:hover { background: #2d1515; }
 
    /* Save confirmation toast */
    .save-toast {
      position: fixed;
      bottom: 90px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: var(--green);
      color: #fff;
      padding: 0.65rem 1.4rem;
      border-radius: 2rem;
      font-size: 0.82rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s, transform 0.25s;
      z-index: 999;
      max-width: 90%;
      white-space: nowrap;
      box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    }
    .save-toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
 
    /* =============================================
       ——— PAGE 5: FITBOT CHAT ———
       Identical layout to workout chat but with
       its own DOM IDs and a different persona.
    ============================================= */
 
    /* FitBot page needs the same height treatment as workout chat */
    #page-fitbot {
      height: calc(100vh - 72px);
      overflow: hidden;
      padding-bottom: 0;
    }
    #page-fitbot .chat-wrap {
      height: 0;
      flex: 1;
      min-height: 0;
      padding-bottom: 80px;
    }

    /* ---- Chat container ---- */
    .chat-wrap {
      display: flex;
      flex-direction: column;
      flex: 1;
      margin: 0 1.25rem 0;
      min-height: 0;
    }
 
    /* Scrollable message list */
    .chat-messages {
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding: 0.75rem 0 0.5rem;
      /* hide scrollbar on webkit */
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
    }
    .chat-messages::-webkit-scrollbar { width: 4px; }
    .chat-messages::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
 
    /* Individual chat bubble */
    .msg {
      max-width: 88%;
      padding: 0.75rem 1rem;
      border-radius: 1.2rem;
      font-size: 0.86rem;
      line-height: 1.6;
      animation: fadeIn 0.25s ease;
    }
    /* AI messages — left aligned */
    .msg.ai {
      background: var(--surface);
      border: 1px solid var(--border);
      align-self: flex-start;
      border-bottom-left-radius: 0.3rem;
    }
    /* User messages — right aligned, accent coloured */
    .msg.user {
      background: var(--accent);
      color: #fff;
      align-self: flex-end;
      border-bottom-right-radius: 0.3rem;
    }
    /* AI name badge above first AI message */
    .msg-meta {
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text2);
      margin-bottom: 0.25rem;
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }
    .msg-meta i { color: var(--accent); }
 
    /* Typing / loading indicator */
    .typing-indicator {
      display: flex;
      align-items: center;
      gap: 4px;
      padding: 0.75rem 1rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 1.2rem;
      border-bottom-left-radius: 0.3rem;
      align-self: flex-start;
      animation: fadeIn 0.25s ease;
    }
    .typing-indicator span {
      width: 7px; height: 7px;
      background: var(--accent);
      border-radius: 50%;
      animation: typingBounce 1.2s ease-in-out infinite;
    }
    .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
    .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
    @keyframes typingBounce {
      0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
      40%            { transform: translateY(-6px); opacity: 1; }
    }
 
    /* Suggested quick-start chips shown on welcome */
    .quick-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.5rem;
    }
    .q-chip {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 2rem;
      padding: 0.3rem 0.75rem;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--text2);
      cursor: pointer;
      transition: all 0.18s;
      white-space: nowrap;
    }
    .q-chip:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
 
    /* ---- Chat input bar ---- */
    .chat-input-bar {
      display: flex;
      gap: 0.5rem;
      padding: 0.75rem 0 0.85rem;
      flex-shrink: 0;
    }
    .chat-input-bar textarea {
      flex: 1;
      resize: none;
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: 1.1rem;
      padding: 0.7rem 1rem;
      font-size: 0.88rem;
      font-family: 'Manrope', sans-serif;
      color: var(--text);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
      max-height: 120px;
      line-height: 1.45;
    }
    .chat-input-bar textarea:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(200,75,49,0.12);
    }
    .send-btn {
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 1.1rem;
      width: 46px;
      height: 46px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: filter 0.15s, transform 0.15s;
      flex-shrink: 0;
      align-self: flex-end;
    }
    .send-btn:hover  { filter: brightness(1.1); transform: translateY(-1px); }
    .send-btn:active { transform: translateY(0); }
    .send-btn:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }
 
    /* Markdown-style formatting inside AI bubbles */
    .msg.ai strong { color: var(--accent); font-weight: 700; }
    .msg.ai ul, .msg.ai ol { padding-left: 1.1rem; margin: 0.4rem 0; }
    .msg.ai li { margin-bottom: 0.2rem; }
    .msg.ai h3 { font-family: 'Syne', sans-serif; font-size: 0.95rem; margin: 0.5rem 0 0.2rem; }
 
    /* =============================================
       5-ITEM NAV — shrink font/icon slightly
    ============================================= */
    .nav-item {
      font-size: 0.6rem; /* slightly smaller for 5 items */
    }
    .nav-item i { font-size: 1.15rem; }
    .mt1 { margin-top: 0.75rem; }
    .spinner { animation: spin 1s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* =============================================
       UTILITY
    ============================================= */
    .mt1 { margin-top: 0.75rem; }
    .spinner { animation: spin 1s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* =============================================
       PAGE HEADINGS
    ============================================= */
    .page-heading {
      padding: 1rem 1.5rem 0;
    }
    .page-heading h1 {
      font-family: 'Syne', sans-serif;
      font-size: 1.55rem;
      font-weight: 800;
      letter-spacing: -0.6px;
    }
    .page-heading p {
      font-size: 0.82rem;
      color: var(--text2);
      margin-top: 0.2rem;
    }

/* =============================================
   RESPONSIVE APPLICATION SHELL
============================================= */
.app {
  width: 100%;
  max-width: none;
}

.header {
  padding: 1rem clamp(1rem, 4vw, 4rem);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.user-email {
  max-width: 220px;
  overflow: hidden;
  color: var(--text2);
  font-size: 0.76rem;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.5rem 0.85rem;
  border: 1px solid var(--border);
  border-radius: 3rem;
  background: var(--surface);
  color: var(--text2);
  font-family: 'Manrope', sans-serif;
  font-size: 0.78rem;
  font-weight: 700;
  cursor: pointer;
  transition: color 0.2s, border-color 0.2s, transform 0.2s;
}

.account-btn:hover {
  color: var(--accent);
  border-color: var(--accent);
  transform: translateY(-1px);
}

.page {
  width: min(100%, 1440px);
  margin-inline: auto;
}

.bottom-nav {
  left: 0;
  max-width: none;
  transform: none;
  justify-content: center;
  padding-inline: clamp(0.25rem, 4vw, 3rem);
}

.nav-item {
  flex: 0 1 160px;
}

.field:last-child {
  max-width: none;
}

@media (min-width: 900px) {
  .page {
    padding: 1.5rem clamp(2rem, 5vw, 5rem) 7rem;
  }

  .page-heading {
    padding: 0 0 0.75rem;
  }

  .page-heading h1 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
  }

  .hero-banner,
  .card,
  .scanner-hero,
  .tips-grid,
  .saved-card {
    margin: 0;
  }

  #page-workout.page.active {
    display: grid;
    grid-template-columns: minmax(320px, 0.85fr) minmax(480px, 1.35fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  #page-workout .hero-banner {
    position: sticky;
    top: 6.5rem;
    height: min(68vh, 620px);
  }

  #page-workout .hero-text h2 {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
  }

  #page-workout .card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  #page-scanner.page.active {
    display: grid;
    grid-template-columns: minmax(360px, 0.9fr) minmax(420px, 1.1fr);
    gap: 1.5rem 2rem;
    align-content: start;
  }

  #page-scanner .page-heading {
    grid-column: 1 / -1;
  }

  #page-scanner .scanner-hero {
    min-height: 420px;
    justify-content: center;
  }

  #page-scanner #productResult {
    min-width: 0;
  }

  #page-scanner .nutrition-card,
  #page-scanner .scanning-msg,
  #page-scanner .error-msg {
    margin: 0;
  }

  .tips-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .tip-card {
    margin: 0;
  }

  .tip-img {
    height: 230px;
  }

  #savedList {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .saved-empty {
    grid-column: 1 / -1;
  }

  #page-fitbot.page.active {
    display: grid;
    grid-template-columns: minmax(320px, 0.8fr) minmax(520px, 1.4fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    height: calc(100dvh - 150px);
    min-height: 560px;
    padding-bottom: 1.5rem;
  }

  #page-fitbot .hero-banner {
    height: 100%;
  }

  #page-fitbot .chat-wrap {
    height: 100%;
    margin: 0;
    padding-bottom: 0;
  }

  .chat-messages {
    padding-top: 0;
  }
}

@media (min-width: 700px) and (max-width: 899px) {
  .page {
    padding-inline: 1.5rem;
  }

  .tips-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .tip-card {
    margin: 0;
  }
}

@media (max-width: 699px) {
  .header {
    padding: 0.9rem 1rem 0.7rem;
  }

  .logo {
    font-size: 1.45rem;
  }

  .header-actions {
    gap: 0.4rem;
  }

  .user-email,
  .account-btn span {
    display: none;
  }

  .theme-btn,
  .account-btn {
    min-width: 42px;
    min-height: 42px;
    justify-content: center;
    padding: 0.55rem;
  }

  .theme-btn span {
    display: none;
  }

  .page {
    padding-bottom: calc(88px + env(safe-area-inset-bottom));
  }

  .bottom-nav {
    padding-bottom: env(safe-area-inset-bottom);
  }

  .row {
    flex-wrap: wrap;
  }

  .field {
    min-width: min(130px, 100%);
  }

  .scan-row {
    flex-direction: column;
  }

  .scan-row .btn {
    width: 100%;
  }

  #page-fitbot {
    height: calc(100dvh - 66px);
  }
}

/* =============================================
   LOGIN AND REGISTRATION
============================================= */
[hidden] {
  display: none !important;
}

.auth-page {
  min-height: 100dvh;
  background:
    radial-gradient(circle at 12% 18%, rgba(232, 119, 61, 0.18), transparent 34%),
    var(--bg);
}

.auth-shell {
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
}

.auth-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.25rem clamp(1rem, 4vw, 4rem);
}

.auth-header .logo {
  text-decoration: none;
}

.auth-layout {
  width: min(100%, 1440px);
  min-height: 0;
  flex: 1;
  display: grid;
  grid-template-columns: minmax(420px, 1.2fr) minmax(380px, 0.8fr);
  gap: clamp(2rem, 6vw, 6rem);
  align-items: center;
  margin-inline: auto;
  padding: clamp(1rem, 4vw, 4rem);
}

.auth-visual {
  min-height: min(680px, 76dvh);
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
  padding: clamp(2rem, 5vw, 4.5rem);
  border-radius: clamp(1.5rem, 3vw, 2.5rem);
  background:
    linear-gradient(180deg, rgba(17, 18, 16, 0.05), rgba(17, 18, 16, 0.9)),
    url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1400&q=85') center/cover;
  color: #fff;
  box-shadow: var(--shadow);
}

.auth-kicker {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  width: fit-content;
  margin-bottom: 1rem;
  padding: 0.45rem 0.8rem;
  border: 1px solid rgba(255,255,255,0.25);
  border-radius: 2rem;
  background: rgba(255,255,255,0.12);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  backdrop-filter: blur(10px);
}

.auth-visual h1 {
  max-width: 720px;
  font-family: 'Syne', sans-serif;
  font-size: clamp(2.7rem, 6vw, 5.7rem);
  line-height: 0.96;
  letter-spacing: -0.055em;
}

.auth-visual p {
  max-width: 600px;
  margin-top: 1.25rem;
  color: rgba(255,255,255,0.78);
  font-size: clamp(0.95rem, 1.4vw, 1.1rem);
  line-height: 1.7;
}

.auth-panel {
  width: min(100%, 500px);
  justify-self: center;
  padding: clamp(1.4rem, 4vw, 2.4rem);
  border: 1px solid var(--border);
  border-radius: 2rem;
  background: var(--surface);
  box-shadow: var(--shadow);
}

.auth-panel h2 {
  margin-bottom: 0.35rem;
  font-family: 'Syne', sans-serif;
  font-size: clamp(1.6rem, 3vw, 2.15rem);
  letter-spacing: -0.04em;
}

.auth-panel > p {
  margin-bottom: 1.35rem;
  color: var(--text2);
  font-size: 0.86rem;
  line-height: 1.6;
}

.auth-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.35rem;
  margin-bottom: 1.35rem;
  padding: 0.35rem;
  border-radius: 1rem;
  background: var(--surface2);
}

.auth-tab {
  padding: 0.7rem;
  border: 0;
  border-radius: 0.75rem;
  background: transparent;
  color: var(--text2);
  font-family: 'Manrope', sans-serif;
  font-weight: 700;
  cursor: pointer;
}

.auth-tab.active {
  background: var(--surface);
  color: var(--accent);
  box-shadow: 0 5px 18px rgba(0,0,0,0.08);
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.auth-field {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.auth-field input {
  width: 100%;
  min-height: 50px;
}

.password-wrap {
  position: relative;
}

.password-wrap input {
  padding-right: 3.25rem;
}

.password-toggle {
  position: absolute;
  top: 50%;
  right: 0.9rem;
  transform: translateY(-50%);
  border: 0;
  background: transparent;
  color: var(--text2);
  cursor: pointer;
}

.auth-submit {
  width: 100%;
  min-height: 50px;
  margin-top: 0.2rem;
}

.auth-submit:disabled {
  opacity: 0.6;
  cursor: wait;
}

.auth-message {
  padding: 0.8rem 0.95rem;
  border: 1px solid var(--border);
  border-radius: 0.9rem;
  background: var(--surface2);
  color: var(--text2);
  font-size: 0.8rem;
  line-height: 1.5;
}

.auth-message.error {
  border-color: rgba(185, 28, 28, 0.25);
  background: rgba(185, 28, 28, 0.08);
  color: #b91c1c;
}

.auth-message.success {
  border-color: rgba(46, 125, 82, 0.25);
  background: rgba(46, 125, 82, 0.1);
  color: var(--green);
}

.auth-note {
  margin-top: 1.1rem;
  color: var(--text2);
  font-size: 0.72rem;
  line-height: 1.55;
  text-align: center;
}

@media (max-width: 900px) {
  .auth-layout {
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .auth-visual {
    min-height: 320px;
  }

  .auth-visual h1 {
    font-size: clamp(2.5rem, 10vw, 4.6rem);
  }

  .auth-panel {
    width: 100%;
    margin-bottom: 2rem;
  }
}

@media (max-width: 560px) {
  .auth-header {
    padding: 1rem;
  }

  .auth-layout {
    padding: 0 1rem 1.5rem;
  }

  .auth-visual {
    min-height: 260px;
    padding: 1.5rem;
    border-radius: 1.5rem;
  }

  .auth-visual p {
    display: none;
  }

  .auth-panel {
    padding: 1.25rem;
    border-radius: 1.5rem;
  }
}
