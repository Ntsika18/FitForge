{
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.js)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/$1"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/register",
      "dest": "/login.html?mode=register"
    },
    {
      "src": "/workout",
      "dest": "/index.html"
    },
    {
      "src": "/scanner",
      "dest": "/scanner.html"
    },
    {
      "src": "/saved",
      "dest": "/saved.html"
    },
    {
      "src": "/fitbot",
      "dest": "/fitbot.html"
    },
    {
      "src": "/tips",
      "dest": "/tips.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
